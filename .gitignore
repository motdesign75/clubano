# .gitignore für Clubano (angepasst)

# Log-Dateien
*.log
*.bak
*.sqlite
*.sql
*.zip

# Umgebungskonfig
.env
.env.*
.env.backup
.env.production

# IDE & System-Dateien
.DS_Store
/.idea
/.vscode
/.phpunit.cache
/.fleet
/.zed
/.nova
auth.json

# Composer & Node Modules
/vendor
/node_modules

# Laravel: temporäre Verzeichnisse
/storage/*.key
/storage/pail

# 🚫 Storage-Ordner ignorieren, außer public
/storage/*
!/storage/app
!/storage/app/public

# Verlinkter Storage-Ordner im öffentlichen Verzeichnis (Symlink)
/public/storage

# Keine Laravel-Quellcodekopien im Webroot
/public/app
/public/bootstrap
/public/config
/public/database
/public/resources
/public/routes
/public/tests
/public/vendor
/public/public
/public/artisan
/public/composer.json
/public/composer.lock
/public/package.json
/public/package-lock.json
/public/phpunit.xml
/public/tailwind.config.js
/public/vite.config.js

# Build-Dateien von Vite
/public/hot
/public/build

# Cache-Dateien
.phpunit.result.cache
npm-debug.log
yarn-error.log
Thumbs.db

# Homestead
Homestead.yaml
Homestead.json

# 💡 Explizit einbeziehen (Whitelist)

# Auth-Controller für Breeze
!app/Http/Controllers/Auth/
!app/Http/Controllers/Auth/**

# Auth-Routen
!routes/auth.php

# Breeze Views (optional, falls sie fehlen)
!resources/views/auth/
!resources/views/auth/**

# E-Mail-Verifizierungsansichten (optional)
!resources/views/emails/
!resources/views/emails/**

/output
/output/pdf
/tmp

# Lokale Planung/Marketing-Arbeitsstände, niemals deployen
/docs/ninox-import/
/marketing/
/public/.php-ini
/public/.php-version
